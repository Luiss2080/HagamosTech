# ============================================================
# HagamosTech - Variables de Entorno (DESARROLLO)
# ============================================================
# Este archivo se usa automaticamente con: npm run dev
# No modificar para produccion - usar .env.production

# URL del backend API (proxy de Vite -> servidor Node en desarrollo)
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://localhost:3001

# URL del endpoint de contacto
VITE_CONTACT_URL=/api/contacto

# Informacion de la aplicacion
VITE_APP_NAME=HagamosTech
VITE_APP_URL=http://localhost:4001
