# ============================================================
# Los Castores - Variables de Entorno (DESARROLLO)
# ============================================================
# Este archivo se usa automaticamente con: npm run dev
# No modificar para produccion - usar .env.production

# URL del backend API (Node.js en localhost)
VITE_API_BASE_URL=http://localhost:3000/api

# URL del endpoint de contacto
VITE_CONTACT_URL=http://localhost:3000/api/contacto

# Informacion de la aplicacion
VITE_APP_NAME=Los Castores
VITE_APP_URL=http://localhost:4001
