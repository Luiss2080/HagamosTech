# HagamosTech - Development Environment (DEFAULT)
# Estas variables se usan en desarrollo local (npm run dev)
# Para producción, usar .env.production

# API Backend (proxy de Vite -> servidor Node en desarrollo)
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://localhost:4321

# URL de contacto (proxy de Vite)
VITE_CONTACT_URL=/api/contacto

# App Info
VITE_APP_NAME=HagamosTech
VITE_APP_URL=http://localhost:4000
