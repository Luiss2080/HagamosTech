generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id                      Int                       @id @default(autoincrement())
  usuario                 String?                   @db.VarChar(50)
  twoFactorSecret         String?                   @map("two_factor_secret") @db.VarChar(255)
  twoFactorEnabled        Boolean                   @default(false) @map("two_factor_enabled")
  nombre                  String                    @db.VarChar(100)
  apellido                String?                   @db.VarChar(100)
  numci                   String?                   @db.VarChar(50)
  fenac                   DateTime?                 @db.Date
  numtel                  String?                   @db.VarChar(20)
  nomcol                  String?                   @db.VarChar(200)
  correo                  String                    @unique @map("email") @db.VarChar(150)
  contrasena              String                    @map("password") @db.VarChar(255)
  fotoPerfil              String?                   @map("foto_perfil") @db.LongText
  rolId                   Int                       @map("rol_id")
  emailVerificado         Boolean                   @default(false) @map("email_verificado")
  activo                  Boolean                   @default(true)
  intentosFallidos        Int                       @default(0) @map("intentos_fallidos")
  bloqueadoHasta          DateTime?                 @map("bloqueado_hasta") @db.DateTime(0)
  ultimoAcceso            DateTime?                 @map("ultimo_acceso") @db.DateTime(0)
  fechaCreacion           DateTime                  @default(now()) @map("creado_en") @db.DateTime(0)
  fechaActualizacion      DateTime                  @default(now()) @updatedAt @map("actualizado_en") @db.DateTime(0)
  rol                     Rol                       @relation(fields: [rolId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_usuarios_rol")
  verificacionCorreos     VerificacionCorreo[]
  recuperacionPasswords   RecuperacionPassword[]
  cuponDescuento          CuponDescuento?

  @@index([rolId], map: "fk_usuarios_rol")
  @@map("usuarios")
}

model CuponDescuento {
  id                       Int       @id @default(autoincrement())
  usuarioId                Int       @unique
  codigo                   String?   @db.VarChar(50)
  estado                   String    @default("pendiente") // "pendiente", "reclamado", "usado", "inactivo"
  extendido                Boolean   @default(false)
  fechaExpiracion          DateTime
  fechaExpiracionExtendida DateTime?
  creadoEn                 DateTime  @default(now())
  actualizadoEn            DateTime  @updatedAt
  usuario                  Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("cupones_descuento")
}

model VerificacionCorreo {
  id        Int      @id @default(autoincrement())
  usuarioId Int      @map("usuario_id")
  token     String   @db.VarChar(255)
  codigo    String?  @db.VarChar(10)
  creadoEn  DateTime @default(now()) @map("creado_en") @db.DateTime(0)
  expiraEn  DateTime @map("expira_en") @db.DateTime(0)
  usado     Boolean  @default(false)
  usadoEn   DateTime? @map("usado_en") @db.DateTime(0)
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade, map: "fk_verif_usuario")

  @@index([usuarioId], map: "fk_verif_usuario")
  @@map("verificacion_correos")
}

model RecuperacionPassword {
  id          Int      @id @default(autoincrement())
  usuarioId   Int      @map("usuario_id")
  token       String   @db.VarChar(255)
  creadoEn    DateTime @default(now()) @map("creado_en") @db.DateTime(0)
  expiraEn    DateTime @map("expira_en") @db.DateTime(0)
  usado       Boolean  @default(false)
  usadoEn     DateTime? @map("usado_en") @db.DateTime(0)
  ipSolicitud String?  @map("ip_solicitud") @db.VarChar(45)
  usuario     Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade, map: "fk_recup_usuario")

  @@index([usuarioId], map: "fk_recup_usuario")
  @@map("recuperacion_password")
}

model RegistroPendiente {
  id         Int      @id @default(autoincrement())
  nombre     String   @db.VarChar(100)
  correo     String   @db.VarChar(150)
  contrasena String   @db.VarChar(255)
  codigo     String   @db.VarChar(10)
  token      String   @db.VarChar(255)
  creadoEn   DateTime @default(now()) @map("creado_en") @db.DateTime(0)
  expiraEn   DateTime @map("expira_en") @db.DateTime(0)
  usado      Boolean  @default(false)

  @@map("registros_pendientes")
}

model Rol {
  id                 Int                  @id @default(autoincrement())
  nombre             String               @db.VarChar(50)
  descripcion        String?              @db.VarChar(200)
  detalleRolPermisos DetalleRolPermisos[]
  usuarios           Usuario[]

  @@map("roles")
}

model Permiso {
  id                 Int                  @id @default(autoincrement())
  nombre             String               @db.VarChar(50)
  descripcion        String?              @db.VarChar(200)
  modulo             String?              @db.VarChar(50)
  detalleRolPermisos DetalleRolPermisos[]

  @@map("permisos")
}

model DetalleRolPermisos {
  id      Int     @id @default(autoincrement())
  fkIdR   Int     @map("fk_id_r")
  fkIdP   Int     @map("fk_id_p")
  permiso Permiso @relation(fields: [fkIdP], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_detalle_permiso")
  rol     Rol     @relation(fields: [fkIdR], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_detalle_rol")

  @@index([fkIdP], map: "fk_detalle_permiso")
  @@index([fkIdR], map: "fk_detalle_rol")
  @@map("detalle_rol_permisos")
}

model ClienteUsuario {
  id                 Int             @id @default(autoincrement())
  correo             String          @unique(map: "Usuario_correo_key")
  contrasena         String
  nombre             String?
  foto_perfil        String?
  email_verificado   Boolean         @default(false)
  telefono           String?
  fechaCreacion      DateTime        @default(now())
  fechaActualizacion DateTime        @updatedAt
  carrito_item       carrito_item[]
  compra             compra[]

  @@map("usuarios_clientes")
}

model PasosCatalogo {
  id          Int     @id @default(autoincrement())
  clave       String  @unique
  icono       String
  colorIcono  String
  titulo      String
  descripcion String  @db.Text
  chip        String?
  orden       Int     @default(0)

  @@map("pasos_catalogo")
}

model categoria {
  id                 Int        @id @default(autoincrement())
  enlace             String     @unique(map: "Categoria_enlace_key")
  titulo             String
  subtitulo          String?
  descripcion        String?    @db.Text
  icono              String?
  etiqueta           String?
  acento             String?
  orden              Int        @default(0)
  activo             Boolean    @default(true)
  fechaCreacion      DateTime   @default(now())
  fechaActualizacion DateTime   @updatedAt
  producto           producto[]
}

model producto {
  id                       Int       @id @default(autoincrement())
  enlace                   String    @unique(map: "Producto_enlace_key")
  nombre                   String
  precio                   Float
  precioAnterior           Float?
  descuento                String?
  calificacion             String?
  imagen                   String?
  insignia                 String?
  descripcion              String?   @db.Text
  descripcionCorta         String?   @db.Text
  disponibilidad           String?
  categoriaId              Int
  stock                    Int       @default(0)
  activo                   Boolean   @default(true)
  fechaCreacion            DateTime  @default(now())
  fechaActualizacion       DateTime  @updatedAt
  carrito_item             carrito_item[]
  compra_item              compra_item[]
  inventarioSucursal       InventarioSucursal[]
  categoria                categoria @relation(fields: [categoriaId], references: [id])

  @@index([categoriaId], map: "producto_categoriaId_fkey")
}

model carrito_item {
  id            Int           @id @default(autoincrement())
  usuarioId     Int
  productoId    Int
  cantidad      Int           @default(1)
  fechaCreacion DateTime      @default(now())
  producto      producto      @relation(fields: [productoId], references: [id])
  usuario       ClienteUsuario @relation(fields: [usuarioId], references: [id])

  @@index([productoId], map: "carrito_item_productoId_fkey")
  @@index([usuarioId], map: "carrito_item_usuarioId_fkey")
}

model compra {
  id                 Int               @id @default(autoincrement())
  codigo             String            @unique
  usuarioId          Int
  sucursalId         Int
  metodoPago         compra_metodoPago @default(qr)
  estado             compra_estado     @default(pendiente_pago)
  totalBs            Float
  nombreCompleto     String?
  telefono           String?
  ciudad             String?
  direccion          String?
  notas              String?           @db.Text
  fechaCreacion      DateTime          @default(now())
  fechaActualizacion DateTime          @updatedAt
  sucursal           sucursal          @relation(fields: [sucursalId], references: [id])
  usuario            ClienteUsuario    @relation(fields: [usuarioId], references: [id])
  compra_item        compra_item[]
  pago               pago[]

  @@index([sucursalId], map: "compra_sucursalId_fkey")
  @@index([usuarioId], map: "compra_usuarioId_fkey")
}

model compra_item {
  id             Int      @id @default(autoincrement())
  compraId       Int
  productoId     Int
  cantidad       Int
  precioUnitario Float
  subtotal       Float
  compra         compra   @relation(fields: [compraId], references: [id])
  producto       producto @relation(fields: [productoId], references: [id])

  @@index([compraId], map: "compra_item_compraId_fkey")
  @@index([productoId], map: "compra_item_productoId_fkey")
}

model sucursal {
  id                       Int                        @id @default(autoincrement())
  nombre                   String
  ciudad                   String
  direccion                String?
  telefono                 String?
  horario                  String?
  servicios                String?
  activo                   Boolean                    @default(true)
  fechaCreacion            DateTime                   @default(now())
  fechaActualizacion       DateTime                   @updatedAt
  compra                   compra[]
  inventarioSucursal       InventarioSucursal[]

  @@index([ciudad], map: "idx_sucursal_ciudad")
}

model InventarioSucursal {
  id                 Int       @id @default(autoincrement())
  sucursalId         Int
  productoId         Int
  stock              Int       @default(0)
  minimo             Int       @default(5)
  fechaCreacion      DateTime  @default(now())
  fechaActualizacion DateTime  @updatedAt
  producto           producto  @relation(fields: [productoId], references: [id])
  sucursal           sucursal  @relation(fields: [sucursalId], references: [id])

  @@unique([sucursalId, productoId], map: "detalle_sucursal_product_sucursal_producto_unique")
  @@index([productoId], map: "detalle_sucursal_product_productoId_fkey")
  @@index([sucursalId], map: "detalle_sucursal_product_sucursalId_fkey")
  @@map("inventario_sucursal")
}

model pago {
  id            Int             @id @default(autoincrement())
  compraId      Int
  metodoPago    pago_metodoPago @default(qr)
  estado        pago_estado     @default(pendiente)
  monto         Float
  referencia    String?
  fechaPago     DateTime?
  fechaCreacion DateTime        @default(now())
  compra        compra          @relation(fields: [compraId], references: [id])

  @@index([compraId], map: "pago_compraId_fkey")
}

model mensaje {
  id            Int             @id @default(autoincrement())
  nombre        String
  correo        String
  telefono      String?
  asunto        String?
  mensaje       String          @db.Text
  tipo          mensaje_tipo?   @default(contacto)
  estado        mensaje_estado? @default(nuevo)
  fechaCreacion DateTime        @default(now())
}

enum pago_metodoPago {
  qr
  tarjeta
  transferencia
  efectivo
}

enum pago_estado {
  pendiente
  pagado
  fallido
  en_verificacion
}

enum compra_metodoPago {
  qr
  tarjeta
  transferencia
  efectivo
}

enum compra_estado {
  pendiente_pago
  pagado
  cancelado
}

enum mensaje_tipo {
  contacto
  pedido
  sugerencia
  soporte
}

enum mensaje_estado {
  nuevo
  leido
  respondido
  archivado
}
