generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id                    Int                    @id @default(autoincrement())
  usuario               String?                @db.VarChar(50)
  twoFactorSecret       String?                @map("two_factor_secret") @db.VarChar(255)
  twoFactorEnabled      Boolean                @default(false) @map("two_factor_enabled")
  nombre                String                 @db.VarChar(100)
  apellido              String?                @db.VarChar(100)
  numci                 String?                @db.VarChar(50)
  fenac                 DateTime?              @db.Date
  numtel                String?                @db.VarChar(20)
  nomcol                String?                @db.VarChar(200)
  correo                String                 @unique @map("email") @db.VarChar(150)
  contrasena            String                 @map("password") @db.VarChar(255)
  fotoPerfil            String?                @map("foto_perfil") @db.Text
  rolId                 Int                    @map("rol_id")
  emailVerificado       Boolean                @default(false) @map("email_verificado")
  activo                Boolean                @default(true)
  intentosFallidos      Int                    @default(0) @map("intentos_fallidos")
  bloqueadoHasta        DateTime?              @map("bloqueado_hasta") @db.Timestamp(0)
  ultimoAcceso          DateTime?              @map("ultimo_acceso") @db.Timestamp(0)
  fechaCreacion         DateTime               @default(now()) @map("creado_en") @db.Timestamp(0)
  fechaActualizacion    DateTime               @default(now()) @updatedAt @map("actualizado_en") @db.Timestamp(0)
  rol                   Rol                    @relation(fields: [rolId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_usuarios_rol")
  verificacionCorreos   VerificacionCorreo[]
  recuperacionPasswords RecuperacionPassword[]
  suscripcion           Suscripcion?
  proyectosPersonales   ProyectoPersonal[]
  notasPersonales       NotaPersonal[]
  eventosPersonales     EventoPersonal[]
  preferenciasPerfil    PreferenciaPerfil?

  @@index([rolId], map: "usuarios_rol_id_idx")
  @@map("usuarios")
}

model Suscripcion {
  id                Int       @id @default(autoincrement())
  usuarioId         Int       @unique
  estado            String    @default("suscrito") @db.VarChar(50)
  fechaFinPrueba    DateTime? @map("fecha_fin_prueba") @db.Timestamp(0)
  invitadoActivado  Boolean   @default(false) @map("invitado_activado")
  invitadoExtendido Boolean   @default(false) @map("invitado_extendido")
  creadoEn          DateTime  @default(now()) @map("creado_en") @db.Timestamp(0)
  actualizadoEn     DateTime  @updatedAt @map("actualizado_en") @db.Timestamp(0)
  usuario           Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("suscripciones")
}

model ProyectoPersonal {
  id            Int              @id @default(autoincrement())
  usuarioId     Int              @map("usuario_id")
  titulo        String           @db.VarChar(120)
  categoria     String           @default("Personal") @db.VarChar(60)
  descripcion   String?          @db.Text
  etapa         String           @default("idea") @db.VarChar(30)
  creadoEn      DateTime         @default(now()) @map("creado_en") @db.Timestamp(0)
  actualizadoEn DateTime         @updatedAt @map("actualizado_en") @db.Timestamp(0)
  usuario       Usuario          @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  notas         NotaPersonal[]
  eventos       EventoPersonal[]

  @@index([usuarioId, actualizadoEn])
  @@map("proyectos_personales")
}

model NotaPersonal {
  id            Int               @id @default(autoincrement())
  usuarioId     Int               @map("usuario_id")
  proyectoId    Int?              @map("proyecto_id")
  titulo        String            @db.VarChar(120)
  contenido     String            @db.Text
  creadoEn      DateTime          @default(now()) @map("creado_en") @db.Timestamp(0)
  actualizadoEn DateTime          @updatedAt @map("actualizado_en") @db.Timestamp(0)
  usuario       Usuario           @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  proyecto      ProyectoPersonal? @relation(fields: [proyectoId], references: [id], onDelete: SetNull)

  @@index([usuarioId, actualizadoEn])
  @@index([proyectoId])
  @@map("notas_personales")
}

model EventoPersonal {
  id            Int               @id @default(autoincrement())
  usuarioId     Int               @map("usuario_id")
  proyectoId    Int?              @map("proyecto_id")
  titulo        String            @db.VarChar(120)
  descripcion   String?           @db.VarChar(500)
  inicio        DateTime          @map("inicio") @db.Timestamp(0)
  fin           DateTime?         @map("fin") @db.Timestamp(0)
  creadoEn      DateTime          @default(now()) @map("creado_en") @db.Timestamp(0)
  actualizadoEn DateTime          @updatedAt @map("actualizado_en") @db.Timestamp(0)
  usuario       Usuario           @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  proyecto      ProyectoPersonal? @relation(fields: [proyectoId], references: [id], onDelete: SetNull)

  @@index([usuarioId, inicio])
  @@index([proyectoId])
  @@map("eventos_personales")
}

model PreferenciaPerfil {
  id                 Int      @id @default(autoincrement())
  usuarioId          Int      @unique @map("usuario_id")
  colorAcento        String   @default("#A3E635") @map("color_acento") @db.VarChar(7)
  privacidadPerfil   String   @default("members") @map("privacidad_perfil") @db.VarChar(20)
  emailPromociones   Boolean  @default(true) @map("email_promociones")
  emailPedidos       Boolean  @default(true) @map("email_pedidos")
  smsAlertas         Boolean  @default(false) @map("sms_alertas")
  actualizadoEn      DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamp(0)
  usuario            Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("preferencias_perfil")
}

model VerificacionCorreo {
  id        Int       @id @default(autoincrement())
  usuarioId Int       @map("usuario_id")
  token     String    @db.VarChar(255)
  codigo    String?   @db.VarChar(10)
  creadoEn  DateTime  @default(now()) @map("creado_en") @db.Timestamp(0)
  expiraEn  DateTime  @map("expira_en") @db.Timestamp(0)
  usado     Boolean   @default(false)
  usadoEn   DateTime? @map("usado_en") @db.Timestamp(0)
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade, map: "fk_verif_usuario")

  @@index([usuarioId], map: "verificacion_correos_usuario_id_idx")
  @@map("verificacion_correos")
}

model RecuperacionPassword {
  id          Int       @id @default(autoincrement())
  usuarioId   Int       @map("usuario_id")
  token       String    @db.VarChar(255)
  creadoEn    DateTime  @default(now()) @map("creado_en") @db.Timestamp(0)
  expiraEn    DateTime  @map("expira_en") @db.Timestamp(0)
  usado       Boolean   @default(false)
  usadoEn     DateTime? @map("usado_en") @db.Timestamp(0)
  ipSolicitud String?   @map("ip_solicitud") @db.VarChar(45)
  usuario     Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade, map: "fk_recup_usuario")

  @@index([usuarioId], map: "recuperacion_password_usuario_id_idx")
  @@map("recuperacion_password")
}

model RegistroPendiente {
  id         Int      @id @default(autoincrement())
  nombre     String   @db.VarChar(100)
  correo     String   @db.VarChar(150)
  contrasena String   @db.VarChar(255)
  codigo     String   @db.VarChar(10)
  token      String   @db.VarChar(255)
  creadoEn   DateTime @default(now()) @map("creado_en") @db.Timestamp(0)
  expiraEn   DateTime @map("expira_en") @db.Timestamp(0)
  usado      Boolean  @default(false)

  @@map("registros_pendientes")
}

model Rol {
  id                 Int                  @id @default(autoincrement())
  nombre             String               @db.VarChar(50)
  descripcion        String?              @db.VarChar(200)
  detalleRolPermisos DetalleRolPermisos[]
  usuarios           Usuario[]

  @@map("roles")
}

model Permiso {
  id                 Int                  @id @default(autoincrement())
  nombre             String               @db.VarChar(50)
  descripcion        String?              @db.VarChar(200)
  modulo             String?              @db.VarChar(50)
  detalleRolPermisos DetalleRolPermisos[]

  @@map("permisos")
}

model DetalleRolPermisos {
  id      Int     @id @default(autoincrement())
  fkIdR   Int     @map("fk_id_r")
  fkIdP   Int     @map("fk_id_p")
  permiso Permiso @relation(fields: [fkIdP], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_detalle_permiso")
  rol     Rol     @relation(fields: [fkIdR], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_detalle_rol")

  @@index([fkIdP], map: "detalle_rol_permisos_fk_id_p_idx")
  @@index([fkIdR], map: "detalle_rol_permisos_fk_id_r_idx")
  @@map("detalle_rol_permisos")
}

model mensaje {
  id            Int             @id @default(autoincrement())
  nombre        String
  correo        String
  telefono      String?
  asunto        String?
  mensaje       String          @db.Text
  tipo          mensaje_tipo?   @default(contacto)
  estado        mensaje_estado? @default(nuevo)
  fechaCreacion DateTime        @default(now())

  @@map("mensaje")
}

enum mensaje_tipo {
  contacto
  pedido
  sugerencia
  soporte
}

enum mensaje_estado {
  nuevo
  leido
  respondido
  archivado
}
