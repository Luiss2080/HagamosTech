# HagamosTech - Backend Environment (PRODUCCIÓN)
# Copiar a .env en el servidor cPanel y ajustar según sea necesario

# Base de datos de producción (cPanel - MySQL)
# En cPanel el host MySQL es "localhost" cuando el backend corre en el mismo servidor.
# Si el backend corre fuera del servidor, usar el host/IP del servidor y habilitar Remote MySQL.
DATABASE_URL=

# Puerto del servidor
PORT=

# Entorno
NODE_ENV=production

# JWT Secret (¡CAMBIAR ESTO! Debe ser una cadena larga y aleatoria)
JWT_SECRET=

# URL del frontend (para CORS en producción)
FRONTEND_URL=

# ── SMTP (cPanel) para envío de correos (verificación de email, etc.) ──
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
