# HagamosTech - Production Environment
# Estas variables se usan SOLO al hacer npm run build
# No afectan al entorno de desarrollo

# API Backend
# Relativa al dominio: el frontend desplegado en Vercel llama a /api.
# Cuando el backend exista, sobreescribe VITE_API_BASE_URL en Vercel
# (Project Settings > Environment Variables) con la URL real de la API.
VITE_API_BASE_URL=/api

# URL de contacto
VITE_CONTACT_URL=/api/contacto

# App Info
VITE_APP_NAME=HagamosTech
VITE_APP_URL=https://hagamos-tech.vercel.app
